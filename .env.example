# ─────────────────────────────────────────────────────
# ARCHIVO DE EJEMPLO — copia como .env.local y rellena
# con tus credenciales reales. NUNCA commitear .env.local
# ─────────────────────────────────────────────────────

# Firebase — Firebase Console → Project Settings → Web App
VITE_FIREBASE_API_KEY=AIzaSy_REEMPLAZA_CON_TU_CLAVE
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto-id
VITE_FIREBASE_STORAGE_BUCKET=tu-proyecto.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:XXXXXXXXXXXXXXXX

# Google Gemini — Google AI Studio → API Keys
VITE_GEMINI_API_KEY=

# Cloud Functions — Firebase Console → Functions → URLs
VITE_CAMPANA_FN_URL=https://us-central1-TU_PROYECTO.cloudfunctions.net/ejecutarCampana
VITE_REDACTOR_FN_URL=https://us-central1-TU_PROYECTO.cloudfunctions.net/aiProxy

# Meta / WhatsApp — Meta for Developers → App → Webhooks
VITE_WHATSAPP_WEBHOOK_URL=https://us-central1-TU_PROYECTO.cloudfunctions.net/whatsappWebhook
VITE_WHATSAPP_VERIFY_TOKEN=reemplaza_con_tu_token_secreto
